NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54721
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email. Leave both unset locally: without a key the signup funnel
# falls back to Supabase's own sender, which reaches Mailpit at
# http://127.0.0.1:54724 with nothing to configure.
#
# Set these in production. The from-address must be on a domain verified in
# Resend — that is the whole of its authorisation model, and an unverified
# sender fails at send time rather than at deploy.
RESEND_API_KEY=
RESEND_FROM=Ryan from Growthable <ryan@news.growthable.io>

# LeadConnector / GoHighLevel. Signups become leads in this sub-account, tagged
# with their survey answers. Both are required for delivery to happen at all;
# with neither set the funnel still works and nothing is sent.
#
# GHL_API_TOKEN: a Private Integration Token with contacts.write on the
# location. GHL_LOCATION_ID: the sub-account the leads land in.
GHL_API_TOKEN=
GHL_LOCATION_ID=

# Optional. Puts the survey answers in custom fields as well as tags, mapping
# our keys to that location's field ids — they are per-location, so there is no
# sensible default. Keys: role, company_size, agency_name, subaccount_count,
# help_centre_url.
# GHL_CUSTOM_FIELDS={"role":"abc123","company_size":"def456"}
GHL_CUSTOM_FIELDS=

# Optional. Anything else that wants the same payload (Zapier, Make, internal).
SIGNUP_WEBHOOK_URL=

# Xovera — the AI chat widget upsell in the customer dashboard.
#
# ONE org-scope key for the whole integration, not one per customer. It can
# create accounts and workspaces for arbitrary email addresses, so it is
# server-side only: never expose it, never give it a NEXT_PUBLIC_ prefix, and
# never import lib/ai-widget/client.ts into a client component.
#
# Unset is a supported state — the dashboard shows the feature as unavailable
# rather than failing on click.
#
# Rate limit: 60 writes per 10 minutes across ALL customers.
XOVERA_API_KEY=
# Defaults to https://app.xovera.io when unset.
XOVERA_BASE_URL=
